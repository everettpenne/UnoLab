<?xml version="1.0" encoding="utf-8"?>
<!-- Fully qualified: the framework resolves these against the package name, which is not the same as the Kotlin package in a build with
     an applicationIdSuffix. The recognition service is required by the role check even though nothing ever listens (no hotword). -->
<voice-interaction-service
    android:sessionService="com.everettpenne.unolab.AssistSessionService"
    android:recognitionService="com.everettpenne.unolab.AssistRecognitionService"
    android:supportsAssist="true"
    xmlns:android="http://schemas.android.com/apk/res/android" />
